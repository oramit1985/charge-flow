NODE_ENV=development
PORT=3000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566
ORDER_EVENT_BUS_NAME=ecommerce-orders
SQS_QUEUE_NAME=shipping-service-order-paid

# DHL Express API — use sandbox base URL for development
# Sandbox: https://express.api.dhl.com/mydhlapi/test
# Production: https://express.api.dhl.com/mydhlapi
DHL_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_API_KEY=your_dhl_api_key
DHL_API_SECRET=your_dhl_api_secret
DHL_ACCOUNT_NUMBER=your_dhl_account_number

# Your company's shipper details (used as the "from" address on all shipments)
DHL_SHIPPER_NAME=My Ecommerce Company
DHL_SHIPPER_EMAIL=shipping@mycompany.com
DHL_SHIPPER_PHONE=+12125551234
DHL_SHIPPER_ADDRESS_LINE1=123 Warehouse St
DHL_SHIPPER_CITY=New York
DHL_SHIPPER_POSTAL_CODE=10001
DHL_SHIPPER_COUNTRY_CODE=US

# Default package weight in kg when item weights are not tracked
DHL_DEFAULT_WEIGHT_KG=1
